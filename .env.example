# =====================================================================
# Project Garud / NetForecast — Environment Configuration Template
# Copy this file to .env and customize for your deployment environment.
# =====================================================================

# ── Service Paths ──────────────────────────────────────────────────
# Directory containing serialized model artifacts (world_model.pt, scaler.pkl, config.json)
ARTIFACTS_DIR=./backend/artifacts

# Directory for SQLite database persistence (forecaster.db)
DB_DIR=./backend/data

# ── Inference & Alert Thresholds ──────────────────────────────────
# Static alert threshold probability [0.0 - 1.0] for infiltration classification
ALERT_THRESHOLD=0.5

# Enable adaptive dynamic thresholding based on live traffic EMA + 2*sigma variance (1=enabled, 0=disabled)
ADAPTIVE_THRESHOLD=1

# ── Security & Authentication ─────────────────────────────────────
# API key for X-API-Key header authentication. Leave empty/unset for demo mode (unauthenticated).
# If set, every HTTP endpoint except /health, /docs, /openapi.json, /redoc and /ws/* requires the X-API-Key header.
API_KEY=

# ── CORS & Frontend Integration ───────────────────────────────────
# Comma-separated list of allowed frontend origins (Vercel, staging, or local development)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ── Frontend Specific (Vite) ──────────────────────────────────────
# URL pointing to the FastAPI backend API service
VITE_API_URL=http://localhost:8000

# Optional API key matching the backend API_KEY for frontend requests
VITE_API_KEY=
