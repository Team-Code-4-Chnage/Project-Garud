# =====================================================================
# Project Garud / NetForecast — Environment Configuration
# =====================================================================

# ── Service Paths ──────────────────────────────────────────────────
ARTIFACTS_DIR=./backend/artifacts
DB_DIR=./backend/data

# ── Inference & Alert Thresholds ──────────────────────────────────
ALERT_THRESHOLD=0.5
ADAPTIVE_THRESHOLD=1

# ── Security & Authentication ─────────────────────────────────────
# Leave empty for unauthenticated local evaluation / demo mode.
API_KEY=

# ── CORS & Frontend Integration ───────────────────────────────────
FRONTEND_URL=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Frontend Specific (Vite) ──────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_API_KEY=
